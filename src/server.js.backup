import http from 'node:http';
import jwt from 'jsonwebtoken';
import { Server } from 'socket.io';
import { createApp } from './app.js';
import { connectDatabase } from './config/db.js';
import { env } from './config/env.js';
import User from './models/User.js';

const app=createApp();
const server=http.createServer(app);
const io=new Server(server,{
 cors:{origin:env.CLIENT_ORIGIN,credentials:true,methods:['GET','POST']},
 maxHttpBufferSize:1e5,
 connectionStateRecovery:{maxDisconnectionDuration:120000,skipMiddlewares:false}
});
app.set('io',io);

io.use(async(socket,next)=>{
 try {
  const token=socket.handshake.auth?.token;
  if(typeof token!=='string'||!token) return next(new Error('Authentication required'));
  const payload=jwt.verify(token,env.JWT_ACCESS_SECRET,{algorithms:['HS256'],issuer:'estateflow-api',audience:'estateflow-client'});
  if(payload.typ!=='access'||!payload.sub||!payload.wid) return next(new Error('Invalid token'));
  const user=await User.findOne({_id:payload.sub,workspace_id:payload.wid,is_active:true}).lean();
  if(!user) return next(new Error('User unavailable'));
  socket.data.user={id:String(user._id),name:user.name,role:user.role,workspace_id:String(user.workspace_id)};
  next();
 } catch { next(new Error('Invalid or expired access token')); }
});
io.on('connection',(socket)=>{
 const w=socket.data.user.workspace_id;
 socket.join(w);
 socket.emit('connection:ready',{user_id:socket.data.user.id});
 socket.on('disconnect',()=>{});
});

await connectDatabase();
server.listen(env.PORT,()=>console.log(`EstateFlow API listening on port ${env.PORT}`));

async function shutdown(signal) {
 console.log(`${signal} received; shutting down`);
 io.close();
 server.close(()=>process.exit(0));
 setTimeout(()=>process.exit(1),10000).unref();
}
process.on('SIGTERM',()=>shutdown('SIGTERM'));
process.on('SIGINT',()=>shutdown('SIGINT'));
